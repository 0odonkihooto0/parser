# Firecrawl
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
# FIRECRAWL_URL=http://localhost:3002        # self-hosted Firecrawl instance

# Server
# PORT=4000
# MAX_UPLOAD_BYTES=52428800                  # max upload size in bytes (default 50 MB)
# INTERNAL_BASE_URL=http://localhost:4000    # address Firecrawl uses to fetch uploads when /parse is unavailable (self-hosted only)

# Security
# CORS_ORIGIN=https://app.example.com,https://admin.example.com  # comma-separated allowed origins
# RATE_LIMIT_MAX=100                         # max requests per 15 min window per IP
# ALLOW_PRIVATE_URLS=false                   # set true to allow scraping loopback/private IPs (self-hosted only)
